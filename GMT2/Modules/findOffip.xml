<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

<Windows>
		
		
	   <Window name="CheckOffIPFind_Window_Template" handleinput="true" savesettings="false" movable="true" popable="true">
         <Size><AbsPoint x="320" y="465" /></Size>
         <Anchors><Anchor point="center" relativePoint="center" relativeTo="Root"><AbsPoint x="0" y="-200" /></Anchor></Anchors>
		 <Windows>
		 		<Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" sticky="false" alpha="0.85">	
				<Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="0" y="0" /></Anchor><Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="0" y="0" /></Anchor></Anchors>
				</Window>
				
				<Label name="$parentTitle"  font="font_clear_small_bold" autoresize="false" textalign="center" layer="overlay" handleinput="false">
				<Size>
				<AbsPoint x="400" y="25" />
				</Size>
				<Anchors>
				<Anchor point="top" relativePoint="top" relativeTo="$parent">
				<AbsPoint x="0" y="5" />
				</Anchor>
				</Anchors>
				<Color r="255" g="218" b="73" />  
				</Label>
		
		
						<EditBox name="$parentEditBox" inherits="EA_EditBox_DefaultFrame" font="font_clear_small_bold" id="51" layer="overlay" maxchars="75" popable="true" handleinput="true" taborder="5">
						<Size><AbsPoint x="200" y="24"/></Size>
					   <Anchors><Anchor point="topright" relativePoint="topleft"  relativeTo="$parentOffIPFindLabel"><AbsPoint x="-9" y="-4" /></Anchor></Anchors>
						<EventHandlers><EventHandler event="OnLButtonUp" function=""/><EventHandler event="OnKeyEnter" function="GMT2.FindIp.UpdateBox" /><EventHandler event="OnKeyEscape" function="" /></EventHandlers>
						</EditBox>		
		
		
		
		
			<Label name="$parentOffIPFindLabel" font="font_clear_small_bold" textalign="left" handleinput="true" autoresize="false" layer="popup">
          <Size><AbsPoint x="80" y="20" /></Size>
		<Color r="255" g="255" b="255" />  	        
		<Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="12" y="30" /></Anchor></Anchors>
        </Label>
		
		
<Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
  <Anchors>
    <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
      <AbsPoint x="-3" y="2"/>
    </Anchor>
  </Anchors>
  <EventHandlers>
    <EventHandler event="OnLButtonUp" function="GMT2.DestroyWindow"/>
  </EventHandlers>
</Button>

		
		<Button name="$parentNameButton" inherits="EA_Button_ListSort" id="3" textalign="center" >
		<Size><AbsPoint x="302" y="30" /></Size>
		<Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground"><AbsPoint x="7" y="52"/></Anchor></Anchors>
		</Button>				

		
		<ListBox name="$parentListBox" color="155, 255, 155, 0" autoHideScrollBar="true" rowdef="CheckOffIPFind_TemplateListboxRow" visiblerows="50" rowcount="50" rowspacing="0">
		<Size><AbsPoint x="343" y="190" /></Size>  
		<Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground"><AbsPoint x="7" y="82"/></Anchor><Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parentBackground"><AbsPoint x="-5" y="-3"/></Anchor></Anchors>
			<!--<EventHandlers><EventHandler event="OnUpdate"  function="GMTools.UpdateColor" /></EventHandlers>  -->
			<ListData table="GetCharTable" populationfunction="">
            <ListColumns><ListColumn windowname="Name"   variable="Buff_Name" format="wstring"/><ListColumn windowname="ID"   variable="ID" format="wstring"/>			</ListColumns>
			</ListData>
        </ListBox>			
		</Windows>
       
      </Window>
		
	<Button name="CheckOffIPFind_TemplateListboxRow" inherits="EA_Button_ResizeIconFrame_NoNormalImage" drawchildrenfirst="true">
      <Size><AbsPoint x="309" y="22" /></Size>
	  <EventHandlers><EventHandler event="OnRButtonUp" function="GMT2.FindIp.LClic" /></EventHandlers>
			
	<Windows>
					 <FullResizeImage name="$parentBG" inherits="EA_FullResizeImage_BlackTransparent" layer="background" alpha="0.5" handleinput="false">        
                    <Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="2" y="1"/></Anchor><Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="-7" y="-1"/></Anchor></Anchors>
					</FullResizeImage>		
	
        <Label name="$parentBuff_Name" font="font_clear_small_bold" textalign="left" handleinput="false" autoresize="false" ellipsisOnCrop="true" warnOnTextCropped="false" layer="popup">
         <Size><AbsPoint x="342" y="20" /></Size>
		<Color r="255" g="218" b="73" />  	        
		<Anchors><Anchor point="left" relativePoint="left" relativeTo="$parent"><AbsPoint x="8" y="2" /></Anchor></Anchors>
        </Label>
				
	</Windows>
 
  </Button>	
		
		
</Windows>
</Interface>

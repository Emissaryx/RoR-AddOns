<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

	<Scripts>
		<Script file="GM_Ticket.lua" />
	</Scripts>
	<Windows>


	    <Button name="GM_Ticket_ItemRowTemplate" inherits="EA_Button_ResizeIconFrame_NoNormalImage" >
			<Size>
				<AbsPoint x="485" y="25" />
			</Size>			
			<EventHandlers>
			<!--	<EventHandler event="OnMouseOver" function="EA_Window_Loot.OnMouseOverItem" /> -->
				<EventHandler event="OnRButtonUp" function="GM_Ticket.Popup" />
				<EventHandler event="OnLButtonUp" function="GM_Ticket.Edit" />
			</EventHandlers>
			<Windows>
				<FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo=""/>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo=""/>
					</Anchors>
						<TintColor r="80" g="15" b="15" a="200"/>
				</FullResizeImage>
                <DynamicImage name="$parentIcon" inherits="EA_Image_DefaultIcon"  handleinput="false" >
			    	<Size>
				        <AbsPoint x="23" y="23" />
			        </Size>
			        <Anchors>
				        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
					        <AbsPoint x="1" y="0" />
				        </Anchor>
			        </Anchors>
			        <Windows>
			        	<DynamicImage name="$parentFrame" inherits="EA_Image_DefaultIconFrame"  handleinput="false" layer="background" >
					        <Size>
						    <AbsPoint x="23" y="23" />
					        </Size>
				        </DynamicImage>
			        </Windows>
			    </DynamicImage>
				<Label name="$parentName" inherits="EA_Label_ChatText" font="font_clear_small_bold" textalign="right" warnOnTextCropped="false" handleinput="false" wordwrap="false">
					<Size>
						<AbsPoint x="110" y="20" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentTimer">
							<AbsPoint x="0" y="0"/>
						</Anchor>
					</Anchors>
					                  <Color r="235" g="235" b="235" />
				</Label>
		<!-- name is assinged name -->
				<Label name="$parentType" inherits="EA_Label_ChatText" font="font_clear_small_bold" textalign="right" warnOnTextCropped="false" handleinput="false" wordwrap="false">
					<Size>
						<AbsPoint x="110" y="20" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="right" relativeTo="$parent">
							<AbsPoint x="-5" y="2"/>
						</Anchor>
					</Anchors>
				</Label>
		
				
					<Label name="$parentCommand" inherits="EA_Label_DefaultText_Small" font="font_clear_small_bold" textalign="left" warnOnTextCropped="false" handleinput="false" wordwrap="false">
					<Size>
						<AbsPoint x="120" y="20" />
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<AbsPoint x="30" y="5"/>
						</Anchor>
					</Anchors>
					  
				</Label>
				
					<Label name="$parentTimer" inherits="EA_Label_DefaultText_Small" font="font_clear_small_bold" textalign="right" warnOnTextCropped="false" handleinput="false" wordwrap="false">
					<Size>
						<AbsPoint x="110" y="20" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentCommand">
							<AbsPoint x="10" y="0"/>
						</Anchor>
					</Anchors>
					<Color r="235" g="235" b="235" />
				</Label>
				
				
				
				     <FullResizeImage name="$parentSelectionBorder" handleinput="false" layer="overlay" texture="EA_TilableSquareFrame_Highlight">
                    <Size>
                        <AbsPoint x="64" y="64" />
                    </Size>
                    <Sizes>
                        <TopLeft x="10" y="10" />
                        <BottomRight x="10" y="10" />
                        <Middle x="44" y="44" />
                    </Sizes>
                    <TexCoords>
                        <TopLeft x="0" y="0" />
                        <TopCenter x="10" y="0" />
                        <TopRight x="54" y="0" />
                        <MiddleLeft x="0" y="10" />
                        <MiddleCenter x="10" y="10" />
                        <MiddleRight x="54" y="10" />
                        <BottomLeft x="0" y="54" />
                        <BottomCenter x="10" y="54" />
                        <BottomRight x="54" y="54" />
                    </TexCoords>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="-2" y="-2"/>
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                            <AbsPoint x="2" y="2"/>
                        </Anchor>
                    </Anchors>
					<TintColor r="255" g="210" b="0" a="80"/>
                </FullResizeImage>
				
				
			</Windows>
		</Button>


		<Window name="GM_Ticket_Window" inherits="EA_Window_Default" movable="true" popable="true" savesettings="false" layer="default" >
			<Size>
				<AbsPoint x="525" y="565" />
			</Size>
			<Anchors>
				<Anchor point="center" relativePoint="center" relativeTo="">
					<AbsPoint x="0" y="0" />
				</Anchor>
			</Anchors>
			<EventHandlers>
			<EventHandler event="OnShown" function="GM_Ticket.Window_OnShow"/>		
			</EventHandlers>
			<Windows>
								
			
  		 		<Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" sticky="false" alpha="0.85">	
				<Anchors>
				<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
				<AbsPoint x="0" y="0" />
				</Anchor>
				<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
				<AbsPoint x="0" y="0" />
				</Anchor>
				</Anchors>
				</Window>
               <!-- <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />        -->
                <Button name="$parentClose" inherits="GMT2_Close_Button" >
				<Anchors>
				<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
				<AbsPoint x="-3" y="2" />
				</Anchor>
				</Anchors>
					<EventHandlers>
						<EventHandler event="OnLButtonUp" function="GM_Ticket.Window_Toggle" />
					</EventHandlers>
				</Button>
				
				
				
				
		<Label name="$parentText" font="font_clear_small_bold" textalign="center" handleinput="false" autoresize="false" layer="popup">
          <Size><AbsPoint x="240" y="20" /></Size>
		<Color r="255" g="218" b="73" />  	        
		<Anchors><Anchor point="top" relativePoint="top" relativeTo="$parent"><AbsPoint x="0" y="7" /></Anchor></Anchors>
        </Label>
				
				
 
				<Label name="$parentTicketCount" inherits="EA_Label_DefaultSubHeading"  textalign="left" textAutoFitMinScale="0.5" >
                    <Size>
                        <AbsPoint x="200" y="20" />
                    </Size>
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent" >
                            <AbsPoint x="210" y="-20" />
                        </Anchor>
                    </Anchors>
                    <Color r="235" g="235" b="235" />
                </Label>	
	
				<!-- List Box of Items  -->
				
				
				
				
				
	
				<ListBox name="$parentList" scrollbar="EA_ScrollBar_DefaultVerticalChain" rowdef="GM_Ticket_ItemRowTemplate"  autoHideScrollBar="true" visiblerows="16" rowcount="200" rowspacing="3">
                    <Size>
                        <AbsPoint x="508" y="445" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" >
                            <AbsPoint x="10" y="60" />
                        </Anchor>
                    </Anchors>

                    <ListData table="GM_Ticket.TicketData" populationfunction="">
                        <ListColumns>
                            <ListColumn windowname="Icon" variable="iconNum" format="icon" />
                            <ListColumn windowname="Name" variable="CharacterName" format="wstring" />  
							<ListColumn windowname="Command" variable="WhatItMeans" format="wstring" />  
							<ListColumn windowname="Timer" variable="CreatedTime" format="wstring" /> 							
							<ListColumn windowname="Type" variable="AssignedAccountName" format="wstring" /> 	
                        </ListColumns>
                    </ListData>
                </ListBox>		
   

<Button name="$parentTypeButton" inherits="EA_Button_ListSort" id="221" textalign="center">
    <Size><AbsPoint x="150" y="30" /></Size>
    <Anchors><Anchor point="topleft" relativePoint="bottomleft" relativeTo="$parentList"><AbsPoint x="-2" y="0"/></Anchor></Anchors>
    <EventHandlers>
        <EventHandler event="OnLButtonUp" function="GM_Ticket.SortByType"/>
    </EventHandlers>
</Button>

<Button name="$parentTimerButton" inherits="EA_Button_ListSort" id="221" textalign="center">
    <Size><AbsPoint x="120" y="30" /></Size>
    <Anchors><Anchor point="topright" relativePoint="topleft" relativeTo="$parentTypeButton"><AbsPoint x="0" y="0"/></Anchor></Anchors>
    <EventHandlers>
        <EventHandler event="OnLButtonUp" function="GM_Ticket.SortByTimer"/>
    </EventHandlers>
</Button>

<Button name="$parentFiledButton" inherits="EA_Button_ListSort" id="221" textalign="center">
    <Size><AbsPoint x="110" y="30" /></Size>
    <Anchors><Anchor point="topright" relativePoint="topleft" relativeTo="$parentTimerButton"><AbsPoint x="0" y="0"/></Anchor></Anchors>
    <EventHandlers>
        <EventHandler event="OnLButtonUp" function="GM_Ticket.SortByFiledBy"/>
    </EventHandlers>
</Button>

<Button name="$parentAssignedButton" inherits="EA_Button_ListSort" id="221" textalign="center">
    <Size><AbsPoint x="110" y="30" /></Size>
    <Anchors><Anchor point="topright" relativePoint="topleft" relativeTo="$parentFiledButton"><AbsPoint x="0" y="0"/></Anchor></Anchors>
    <EventHandlers>
        <EventHandler event="OnLButtonUp" function="GM_Ticket.SortByAssigned"/>
    </EventHandlers>
</Button>
					

   

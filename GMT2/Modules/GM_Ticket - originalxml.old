					<TextColors>
						<Normal r="50" g="255" b="50" a="255"/>
						<NormalHighlit r="255" g="85" b="0" a="255"/>
						<Pressed r="95" g="57" b="36" a="255"/>
						<PressedHighlit r="95" g="57" b="36" a="255"/>
						<Disabled r="95" g="57" b="36" a="255" />
						<DisabledPressed r="95" g="57" b="36" a="255" />
					</TextColors>  
					</Button>

    LogDisplaySetFilterColor( "GM_Ticket_InfoLogDisplay", "GM_TicketLog", GameData.AppealAuthor.CS, DefaultColor.YELLOW.r, DefaultColor.YELLOW.g, DefaultColor.YELLOW.b )
	LogDisplaySetFilterColor( "GM_Ticket_InfoLogDisplay", "GM_TicketLog", 999, DefaultColor.BLUE.r, DefaultColor.BLUE.g, DefaultColor.BLUE.b )

	
	
	

GM_Ticket.Cache.Latest_Ticket_ID = towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].Id)
else
return
end




local Filed_Char = towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].CharacterName)
LabelSetText("GM_Ticket_InfoItem2Text",towstring(CreateHyperLink(L"PLAYER:"..towstring(Filed_Char),towstring(Filed_Char), {100,100,255}, {} )))

if towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].Issued_By) == L"<Deleted Character>" then
ButtonSetDisabledFlag("GM_Ticket_InfoAnswerButton",true)
else
ButtonSetDisabledFlag("GM_Ticket_InfoAnswerButton",false)
end


	-- if 		GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].Ticket_TempParamText ~=  L"0" then

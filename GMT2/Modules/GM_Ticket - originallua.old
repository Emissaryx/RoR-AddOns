			return L"Bug: Quest & PQ",tonumber(30457)
		elseif Category == 5 then
			return L"Bug: Item",tonumber(30457)
		elseif Category == 6 then
			return L"Bug: Other",tonumber(30457)			
		end	
	elseif Type == 5 then -- feedback	
		if Category == 7 then
			return L"Feedback: Cities",tonumber(23056)
		elseif Category == 8 then
			return L"Feedback: ToK",tonumber(23056)	
		elseif Category == 9 then
			return L"Feedback: Quest & PQ",tonumber(23056)	
		elseif Category == 10 then
			return L"Feedback: Career",tonumber(23056)	

function GMT2.LinkStuff(linkParam)
d(linkParam)

end

function GM_Ticket.Map()
	WindowSetShowing("EA_Window_WorldMap",true)
	EA_Window_WorldMap.currentMap = tonumber(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].ZoneId)
	EA_Window_WorldMap.ShowZone( tonumber(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].ZoneId) )
	GMT2.Map.UpdatePinCoordinates()	
end


function GM_Ticket.Meny()
	local WinParent = WindowGetParent(SystemData.ActiveWindow.name)
	local SendName = ButtonGetText(SystemData.MouseOverWindow.name)
	local CustomButtons = {}

	
	PlayerMenuWindow.ShowMenu( towstring(SendName), 0,  CustomButtons)

end


function GM_Ticket.Clear()
	GM_Ticket.TicketIndex = 0
	GM_Ticket.TicketNumbers = 0
	GM_Ticket.TicketID = {}

	SendChatText(L"]ticket numberOfTickets", L"")
GM_Ticket.Update()	
end

	
function GM_Ticket.ReSort()
GM_Ticket.TempSort = nil
GM_Ticket.TempSort = GM_Ticket.TicketData
GM_Ticket.TicketData = {}
local TempSortNumber = 1

	for lootIndex, _ in pairs( GM_Ticket.TempSort ) do
	GM_Ticket.TicketData[TempSortNumber] = GM_Ticket.TempSort[lootIndex]
	
	GM_Ticket.TicketData[TempSortNumber].IndexNumber = TempSortNumber
	
	TempSortNumber = TempSortNumber+1
	--	d(L"lootIndex: "..towstring(lootIndex)..L" , ")
		
	end   	
	
	return
end

function GM_Ticket.Delete()
--d(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Ticket_ID)
SendChatText(L"]ticket delete "..towstring(GM_Ticket.Cache.Latest_Ticket_ID), L"")
GM_Ticket.Update()
end


function GM_Ticket.Assign_Me()
d(L"]ticket assignMe "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Id))
SendChatText(L"]ticket assignMe "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Id), L"")
GM_Ticket.Update()
end


function GM_Ticket.AssignDialog()
DialogManager.MakeTextEntryDialog( L"Assign Ticket", L"Who to assign this ticket to?", L"None", GM_Ticket.Assign)
end


function GM_Ticket.Assign( playerName )
if towstring(playerName) == L"" then playerName = L"None" end
SendChatText(L"]ticket assign "..towstring(playerName)..L" "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Ticket_ID), L"")
GM_Ticket.Update()
end

function GM_Ticket.AnswerDialog(SelectedOption)
if ButtonGetDisabledFlag("GM_Ticket_InfoAnswerButton") == false then
local CurrentText = SelectedOption 

if CurrentText == L"0" then CurrentText = L"" end

local DialogID = tostring(DialogManager.FindAvailableDialog( DialogManager.textEntryDlgs, DialogManager.NUM_TEXT_ENTRY_DLGS_PER_TYPE, DialogManager.MULTI_LINE_DLGS_START ))

DialogManager.MakeTextEntryDialog( L"Reply Ticket", L"Reply to: "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.CurrentEdit]].CharacterName)..L" with message:", towstring(CurrentText) , GM_Ticket.Answer, nil, 1000, true,10)

WindowSetDimensions("TextEntryDlg"..DialogID,600,500)
WindowSetDimensions("TextEntryDlg"..DialogID.."TextEntry",554,300)
end
end


function GM_Ticket.OptionAnswerDialog()
if ButtonGetDisabledFlag("GM_Ticket_InfoAnswerButton") == false then
local function MakeCallBack( SelectedOption )
		    return function() GM_Ticket.AnswerDialog(SelectedOption) end
		end
    EA_Window_ContextMenu.CreateContextMenu( "Respons Menu", EA_Window_ContextMenu.CONTEXT_MENU_1, L"Respons Menu" )
    EA_Window_ContextMenu.AddMenuDivider( EA_Window_ContextMenu.CONTEXT_MENU_1 )
	
	for k , v in pairs (GM_Ticket.AnswerOption) do
	  EA_Window_ContextMenu.AddMenuItem( towstring(v.name), MakeCallBack( towstring(v.text) ), false, true, EA_Window_ContextMenu.CONTEXT_MENU_1 )
	end   
    EA_Window_ContextMenu.Finalize()
end
end

function GM_Ticket.TestFunc(text)
d(text)
end


function GM_Ticket.Answer( AnswerText )
SendChatText(L"]ticket answer "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Id)..L" "..towstring(AnswerText), L"")
GM_Ticket.Update()
end



function GM_Ticket.UnAssign()
d(L"]ticket assign None "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Id))
SendChatText(L"]ticket assign None "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Id), L"")
GM_Ticket.Update()	
end

function GM_Ticket.DeleteDialog()
DialogManager.MakeTwoButtonDialog( L"Delete Ticket?", GetString(StringTables.Default.LABEL_YES),GM_Ticket.Delete,GetString(StringTables.Default.LABEL_NO),nil )
d(GM_Ticket.Cache.Latest_Ticket_ID)
end

function GM_Ticket.Window_Toggle()
if WindowGetShowing("GM_Ticket_Window") == true then
WindowSetShowing("GM_Ticket_Window",false)
WindowSetShowing("GM_Ticket_Info",false)
else
WindowSetShowing("GM_Ticket_Window",true)
WindowSetShowing("GM_Ticket_Info",true)
end
end

function GM_Ticket.Window_OnShow()
WindowAssignFocus("GM_Ticket_InfoMessageBox",false)
GM_Ticket.Clear()
end


function GM_Ticket.OnClickMap()


		local MapInfo = GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]]
		local TempX = GMT2.Map.Zone[MapInfo.ZoneId].WorldTopX + MapInfo.X
		local TempY = GMT2.Map.Zone[MapInfo.ZoneId].WorldTopY + MapInfo.Y
		local TempZ = MapInfo.Z

	local function InputSelect()
		GMT2.Teleport(PlayerName,4,{MapInfo.ZoneId,TempX,TempY,TempZ})		
	end	

local custom_menu_items = {}
EA_Window_ContextMenu.CreateContextMenu ("GMTOOLSMAPTOOLS",1,L"GMTools: "..towstring(GetStringFromTable("ZoneNames", MapInfo.ZoneId )))
EA_Window_ContextMenu.AddMenuDivider( EA_Window_ContextMenu.CONTEXT_MENU_1 )
EA_Window_ContextMenu.AddMenuItem (L"<icon42>Teleport to this location ",InputSelect ,false, true)
EA_Window_ContextMenu.AddMenuItem (L"<icon59>Cache This Location", function() GMT2.Map.Cache = {id=MapInfo.Zoneid,x=TempX,y=TempY,z=TempZ} end,false, true)	
	if GMT2.Cache_Name ~= nil then
		EA_Window_ContextMenu.AddMenuItem (L"<icon59>Teleport <icon23056>"..towstring(GMT2.Cache_Name)..L" Here",function() GMT2.Teleport(GMT2.Cache_Name,4,{MapInfo.ZoneId,TempX,TempY,TempZ}) end,false, true)	
	end
EA_Window_ContextMenu.Finalize ()


end

function GM_Ticket.ExitWindow()
    if WindowGetShowing("GM_Ticket_Window") then
        WindowSetShowing("GM_Ticket_Window", false)
        WindowSetShowing("GM_Ticket_Info", false) -- If you want to hide the Info window as well
    end
end

function GM_Ticket.ButtonPressed()

local Button_id = WindowGetId (SystemData.ActiveWindow.name)
GM_Ticket.SelectedTab = Button_id
WindowSetShowing("GM_Ticket_InfoLogDisplay",GM_Ticket.SelectedTab == 2)
WindowSetShowing("GM_Ticket_InfoMessageBox",GM_Ticket.SelectedTab == 1)
ButtonSetPressedFlag("GM_Ticket_InfoMessageButton",GM_Ticket.SelectedTab == 1)
ButtonSetPressedFlag("GM_Ticket_InfoCommentButton",GM_Ticket.SelectedTab == 2)

end
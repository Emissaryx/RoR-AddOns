if not 	GM_Ticket.AnswerOption then
	GM_Ticket.AnswerOption = {
	Option_1 = {name=L"Review",text=L"Your Ticket Submission requires further details to take action. Please contact a GM via Discord, Forums, or email with additional information."},
	Option_2 = {name=L"Approved",text=L"Your Ticket Submission has been Approved and appropriate action has been taken."},
	Option_3 = {name=L"Denied",text=L"Your Ticket Submission has been denied and closed. This submission did not meet our requirements for sanctions and is considered acceptable."},
	Option_4 = {name=L"Unknown",text=L"Your Ticket Submission has been closed due to lack of information. Please be aware the ticket system does generate additional work for GM's and should not be abused."},
	Option_5 = {name=L"No Items",text=L"Your Ticket Submission has been closed. The ROR team will not provide items if they are lost or destroyed. This is simply more work than would be reasonable for a small team."},
	Option_6 = {name=L"Bugtracker",text=L"Your Ticket Submission has been closed. Despite categories, all items in the GM Appeal section are intended for Rule Enforcement. Bugs should be posted on the bugtracker, linked at the top of the forums. Most common questions can be asked in the /advice channel."},
	Option_7 = {name=L"Feedback",text=L"Your Ticket Submission has been closed. Please provide feedback on the forums. The GM Appeals are intended only for Rule Enforcement."},
	Option_8 = {name=L"Not My Problem!",text=L"Your Ticket Submission has been closed. This is simply not something we address around here."}
	}
end
	
	_hookOnHyperLinkLButtonUp = EA_ChatWindow.OnHyperLinkLButtonUp
	_hookOnHyperLinkRButtonUp = EA_ChatWindow.OnHyperLinkRButtonUp
		

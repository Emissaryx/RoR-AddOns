function GM_Ticket.Update()
  GM_Ticket.TicketData = nil
   GM_Ticket.TicketData = GM_Ticket.TicketID

    GM_Ticket.TicketDataDisplayOrder = {}
    
	GM_Ticket.ReSort()
	
	for lootIndex, _ in pairs( GM_Ticket.TicketData ) 
	do
	    table.insert( GM_Ticket.TicketDataDisplayOrder, lootIndex )
	--	d(L"lootIndex: "..towstring(lootIndex)..L" , ")
		
	end  



GM_Ticket.sortlist(GM_Ticket.TicketData,GM_Ticket.TicketDataDisplayOrder) 	


    ListBoxSetDisplayOrder("GM_Ticket_WindowList", GM_Ticket.TicketDataDisplayOrder )
	
GM_Ticket.Populate2()
return	
	--if 	GM_Ticket.CurrentEdit ~= nil or GM_Ticket.CurrentEdit ~= 0  then WindowSetShowing("GM_Ticket_WindowListRow"..GM_Ticket.CurrentEdit.."SelectionBorder", true) end
end


function GM_Ticket.sortlist(index,tablename)-- Sorting the tables
 --name
if GM_Ticket.SortPriority == 0 then
    table.sort(index, function (a,b)
      return (tonumber(a.IndexNumber) < tonumber(b.IndexNumber))
    end)
elseif 	GM_Ticket.SortPriority == 1 then
    table.sort(index, function (a,b)
      return (a.Type > b.Type)
    end)
	
end
	
end

function GM_Ticket.Edit()
TextLogClear("GM_TicketLog")
    -- Convert the Row index to the item index
local _index = ListBoxGetDataIndex("GM_Ticket_WindowList", WindowGetId(SystemData.MouseOverWindow.name)) or GM_Ticket.SelectedListBox

GM_Ticket.SelectedListBox = _index

GM_Ticket.SelectedTab = 1
WindowSetShowing("GM_Ticket_InfoLogDisplay",GM_Ticket.SelectedTab == 2)
WindowSetShowing("GM_Ticket_InfoMessageBox",GM_Ticket.SelectedTab == 1)
ButtonSetPressedFlag("GM_Ticket_InfoMessageButton",GM_Ticket.SelectedTab == 1)
ButtonSetPressedFlag("GM_Ticket_InfoCommentButton",GM_Ticket.SelectedTab == 2)

WindowAssignFocus("GM_Ticket_InfoMessageBox",false)

if GM_Ticket.SelectedListBox ~= nil then		

if _index ~= nil and GM_Ticket.TicketDataDisplayOrder[_index] ~= nil then

GM_Ticket.IndexNumber = GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].IndexNumber	
local TicketData = GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]]

	
LabelSetText("GM_Ticket_InfoItem1Text",towstring(TicketData.Id) or L"error? InfoIDTextBox")

TextEditBoxSetText("GM_Ticket_InfoMessageBox",towstring(TicketData.Fields["0"]) or L"error? InfoMessageBox")
LabelSetText("GM_Ticket_InfoTitleLabel",towstring(TicketData.WhatItMeans) or L"error? InfoTitleLabel")
--LabelSetText("GM_Ticket_InfoAccountLabel",L"Account: "..towstring(GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[_index]].Ticket_Account_Name) or L"error? InfoAccountLabel")
LabelSetText("GM_Ticket_InfoItem3Title",L"Account:")
LabelSetText("GM_Ticket_InfoItem3Text",towstring(TicketData.AccountName) or L"error? InfoAccountLabel")


LabelSetText("GM_Ticket_InfoItem4Title",L"Zone")


LabelSetText("GM_Ticket_InfoItem4Text",towstring(CreateHyperLink(L"MAPCORDS:"..towstring(TicketData.ZoneId)..L":"..towstring(TicketData.X)..L":"..towstring(TicketData.Y)..L":"..towstring(TicketData.Z),towstring(GetStringFromTable("ZoneNames",TicketData.ZoneId)), {0,225,0}, {} )))

for i=5,8 do
	WindowSetShowing("GM_Ticket_InfoItem"..i,false)
end

if TicketData.Fields["1"] == "" then
TicketData.Fields["1"] = towstring(TicketData.WhatItMeans)
end


local FieldNumber = 5
for k,v in pairs(TicketData.Fields) do
if k ~= "0" then
if k == "4" then
LabelSetText("GM_Ticket_InfoItem"..FieldNumber.."Text",towstring(CreateHyperLink(L"PLAYER:"..towstring(v),towstring(v), {255,50,50}, {} )))	
else
LabelSetText("GM_Ticket_InfoItem"..FieldNumber.."Text",towstring(v))
end
LabelSetText("GM_Ticket_InfoItem"..FieldNumber.."Title",towstring(FieldConvert[k+1]))
WindowSetShowing("GM_Ticket_InfoItem"..FieldNumber,true)
FieldNumber = FieldNumber+1
end
end


	EA_Window_WorldMap.currentMap = tonumber(TicketData.ZoneId)
	EA_Window_WorldMap.ShowZone( tonumber(TicketData.ZoneId) )
	GMT2.Map.TargetPin = {Zone = tonumber(TicketData.ZoneId),X=tonumber(TicketData.X),Y=tonumber(TicketData.Y),Name=towstring(TicketData.CharacterName)}
	GMT2.Map.UpdatePinCoordinates()



if TicketData.Comments[1] ~= nil then
TextLogClear("GM_TicketLog")
for k,v in ipairs(TicketData.Comments[1]) do
if v.Author == "Player" then
TextLogAddEntry("GM_TicketLog", GameData.AppealAuthor.PLAYER,L"["..TimeUtils.FormatTime(math.abs(tonumber(v.Time)))..L"] ["..towstring(v.Name)..L"] "..towstring(v.Text))
elseif v.Author == "Cs" then
TextLogAddEntry("GM_TicketLog", GameData.AppealAuthor.CS,L"["..TimeUtils.FormatTime(math.abs(tonumber(v.Time)))..L"] ["..towstring(v.Name)..L"] "..towstring(v.Text))
end

end
end



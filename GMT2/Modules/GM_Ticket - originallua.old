		end
	end
return L"Issue Topic",tonumber(141)
end

function GM_Ticket.GetReportType(Type)
	if Type == 0 then
	return L""
	elseif Type == 1 then
	return L"General"
	elseif Type == 2 then
	return L"Harassment"
	elseif Type == 3 then
	return L"Zone Disruptment"
	elseif Type == 4 then
	return L"XP/RP farming"
	elseif Type == 5 then
	return L"Speed Hacking"
	elseif Type == 6 then
	return L"Macriong"	
	elseif Type == 7 then
	return L"Kill Stealing"
	elseif Type == 8 then
	return L"X-Realming"
	end
	return L""
end



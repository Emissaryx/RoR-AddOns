function GM_Ticket.OnChatLogUpdated(updateType, filterType) 
	if( updateType == SystemData.TextLogUpdate.ADDED ) then 			
		if filterType == SystemData.ChatLogFilters.CHANNEL_9 then	
			local _, filterId, text = TextLogGetEntry( "Chat", TextLogGetNumEntries("Chat") - 1 ) 
				if text:find(L"TICKET_REPORT:") then 
--				PlaySound(GameData.Sound.QUEST_ABANDONED)
				GM_Ticket.GotTicket(text)
			elseif text:find(L"TICKET_HEADER:") then 
--				PlaySound(GameData.Sound.QUEST_ABANDONED)
				GM_Ticket.GotTicket2(text)
			elseif text:find(L"TICKET_FIELD:") then 
--				PlaySound(GameData.Sound.QUEST_ABANDONED)
				GM_Ticket.UpdateField(text)
			elseif text:find(L"TICKET_COMMENT:") then 
--				PlaySound(GameData.Sound.QUEST_ABANDONED)
				GM_Ticket.UpdateComment(text)								
			elseif text:find(L"TICKET_END") then 				
				
				GM_Ticket.Populate2()
				
			elseif text:find(L"TICKET_NUMBER:") then 
			GM_TicketInfo = {}
			GM_Ticket.GotNumber(text)
			--SendChatText(L"]ticket list", L"")
			SendChatText(L"]ticket list2", L"")
			elseif text:find(L"NEW_TICKET") then 
			PlaySound(GameData.Sound.QUEST_ABANDONED)
			local SlaskeAlert = { section =30, entry = 0, subEntry = 0, name = L"New Ticket!", text =L"A new ticket has arrived!", xp = 0, useName = true }
			TomeAlertWindow.QueueAlert( SlaskeAlert )
			GM_Ticket.Clear()
			end
		elseif filterType == 12000 or filterType == SystemData.SystemLogFilters.GENERAL then	
					local _, filterId, text = TextLogGetEntry( "Chat", TextLogGetNumEntries("Chat") - 1 ) 
				if text:find(L"You have unassigned") or text:find(L"You have assigned") or text:find(L"You have deleted") or text:find(L"You have answered")then 
	--			d("assign and stuff")
				GM_Ticket.Clear()
				end

		end
	end
end


function GM_Ticket.GotTicket2(text)
text = string.gsub (tostring(text),"TICKET_HEADER:","")
local LIST_SPLIT_TEXT = StringSplit(tostring(text), "_;_")	
d(LIST_SPLIT_TEXT)
local Title,icon = GM_Ticket.GetList(tonumber(LIST_SPLIT_TEXT[10]),tonumber(LIST_SPLIT_TEXT[11]))
GM_TicketInfo[LIST_SPLIT_TEXT[1]] = {
Fields = {},
Comments = {[1]={},[2]={}},
Id=tostring(LIST_SPLIT_TEXT[1]),
AccountId=tonumber(LIST_SPLIT_TEXT[2]),
AccountName=towstring(LIST_SPLIT_TEXT[3]),
CharacterId=tonumber(LIST_SPLIT_TEXT[4]),
CharacterName=towstring(LIST_SPLIT_TEXT[5]),
ZoneId=tonumber(LIST_SPLIT_TEXT[6]),
X=tonumber(LIST_SPLIT_TEXT[7]),
Y=tonumber(LIST_SPLIT_TEXT[8]),
Z=tonumber(LIST_SPLIT_TEXT[9]),
Type=tonumber(LIST_SPLIT_TEXT[10]),
Topic=tonumber(LIST_SPLIT_TEXT[11]),
Status=tonumber(LIST_SPLIT_TEXT[12]),
CreatedTime=TimeUtils.FormatTime(math.abs(tonumber(LIST_SPLIT_TEXT[13]))),
UpdatedTime=tonumber(LIST_SPLIT_TEXT[14]),
AssignedAccountId=tonumber(LIST_SPLIT_TEXT[15]),
AssignedAccountName=towstring(LIST_SPLIT_TEXT[16]),
iconNum = icon,
WhatItMeans = towstring(Title)
}
end

function GM_Ticket.UpdateField(text)
text = wstring.gsub (text,L"TICKET_FIELD:",L"")
local LIST_SPLIT_TEXT = WStringSplit(text, L"_;_")    
d(LIST_SPLIT_TEXT[3])
if LIST_SPLIT_TEXT[3] ~= "" then
GM_TicketInfo[tostring(LIST_SPLIT_TEXT[1])].Fields[tostring(LIST_SPLIT_TEXT[2])] = LIST_SPLIT_TEXT[3]
end
end

function GM_Ticket.UpdateComment(text)
text = string.gsub (tostring(text),"TICKET_COMMENT:","")
local LIST_SPLIT_TEXT = StringSplit(tostring(text), "_;_")	
--d(LIST_SPLIT_TEXT)
table.insert(GM_TicketInfo[LIST_SPLIT_TEXT[1]].Comments[tonumber(LIST_SPLIT_TEXT[2]+1)],{Author=LIST_SPLIT_TEXT[3],Time=LIST_SPLIT_TEXT[6],Name=LIST_SPLIT_TEXT[5],Text=LIST_SPLIT_TEXT[7]})
--GM_TicketInfo[LIST_SPLIT_TEXT[1]].Comments[tonumber(LIST_SPLIT_TEXT[2]+1)][math.abs(tonumber(LIST_SPLIT_TEXT[6]))] = {Author=LIST_SPLIT_TEXT[3],Time=LIST_SPLIT_TEXT[6],Name=LIST_SPLIT_TEXT[5],Text=LIST_SPLIT_TEXT[7]}
end


function GM_Ticket.Populate2()
 GM_Ticket.TicketData = nil
   GM_Ticket.TicketData = GM_TicketInfo

    GM_Ticket.TicketDataDisplayOrder = {}
    
	GM_Ticket.ReSort()
	
	for lootIndex, _ in pairs( GM_Ticket.TicketData ) 
	do
	    table.insert( GM_Ticket.TicketDataDisplayOrder, lootIndex )
	--	d(L"lootIndex: "..towstring(lootIndex)..L" , ")
		
	end  



GM_Ticket.sortlist(GM_Ticket.TicketData,GM_Ticket.TicketDataDisplayOrder) 	


    ListBoxSetDisplayOrder("GM_Ticket_WindowList", GM_Ticket.TicketDataDisplayOrder )


local Index = 0 
for row, data in pairs( GM_Ticket.TicketData) do
	 Index = Index +1 
        if Index < 17 then
        local rowName   = "GM_Ticket_WindowListRow"..Index
		local RowNumber = 	ListBoxGetDataIndex("GM_Ticket_WindowList",Index)
			
		WindowSetTintColor(  rowName.."Background", 0,0,0)
		--if DoesWindowExist("GM_Ticket_WindowListRow"..RowNumber.."SelectionBorder") then WindowSetShowing("GM_Ticket_WindowListRow"..RowNumber.."SelectionBorder", false) end


		

		WindowSetTintColor(  rowName.."Background", 70,10,10)	
	
	
	if GM_Ticket.IndexNumber == Index then 
		WindowSetShowing(rowName.."SelectionBorder", true) 
		WindowSetTintColor(  rowName.."Background", 150,120,0)
	else 
		WindowSetShowing(rowName.."SelectionBorder", false) 
	end
	
 
 end
      
    end
end


function GM_Ticket.GotNumber(text)
--	d("GotNumber")
	GM_Ticket.TicketNumbers = text:match(L"TICKET_NUMBER:([0-9]+)")
	return
end

function GM_Ticket.Popup()
GM_Ticket.Edit()
local IsAssigned = GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].AssignedAccountName ~= L"None"




--GM_Ticket.TicketData[GM_Ticket.TicketDataDisplayOrder[GM_Ticket.SelectedListBox]].Ticket_AssignedTo
    -- Convert the Row index to the item index
	EA_Window_ContextMenu.CreateContextMenu( "GM-ToolsMenu", 1, L"Ticket Option")
		EA_Window_ContextMenu.AddMenuItem( L"Assign Me", GM_Ticket.Assign_Me, IsAssigned, true, 1 )
		EA_Window_ContextMenu.AddMenuItem( L"Assign To..",GM_Ticket.AssignDialog, IsAssigned, true, 1 )
		EA_Window_ContextMenu.AddMenuItem( L"UnAssign",GM_Ticket.UnAssign,not IsAssigned, true, 1 )
		EA_Window_ContextMenu.AddMenuItem( L"Reply..",GM_Ticket.AnswerDialog, not IsAssigned, true, 1 )	

if GM_Ticket.AnswerOption then
	EA_Window_ContextMenu.AddCascadingMenuItem( L"Reply Presigned",GM_Ticket.AnswerOptionMenu,  not IsAssigned, 1 )	
end	
		--EA_Window_ContextMenu.AddCascadingMenuItem( L"Close Presigned",GM_Ticket.OptionAnswerDialog, false, 2 )		
		EA_Window_ContextMenu.AddMenuItem( L"Close",GM_Ticket.DeleteDialog, not IsAssigned, true, 1 )		
	
--	EA_Window_ContextMenu.AddMenuItem( L"CheckLog",SendCommand("checklog",Target_Name), false, true,2 )
--	EA_Window_ContextMenu.AddMenuItem( L"GetChar",SendCommand("getchar",Target_Name), false, true,2 )  
  			
	EA_Window_ContextMenu.AddMenuDivider( 1 )
	EA_Window_ContextMenu.AddMenuItem( GetString( StringTables.Default.LABEL_PLAYER_MENU_CANCEL ), PlayerMenuWindow.OnCancel, false, true,1 )        			
	EA_Window_ContextMenu.Finalize( 1 )
end

function GM_Ticket.AnswerOptionMenu()
local function MakeCallBack( SelectedOption )
		    return function() GM_Ticket.AnswerDialog(SelectedOption) end
		end
		

	EA_Window_ContextMenu.CreateContextMenu( "Response Menu", 2, L"Response Menu")
		for k , v in pairs (GM_Ticket.AnswerOption) do
	  EA_Window_ContextMenu.AddMenuItem( towstring(v.name), MakeCallBack( towstring(v.text) ), false, true, 2 )
	end   		
		EA_Window_ContextMenu.AddMenuDivider( 2 )		
		EA_Window_ContextMenu.AddMenuItem( GetString( StringTables.Default.LABEL_PLAYER_MENU_CANCEL ), PlayerMenuWindow.OnCancel, false, true, 2 )        
		EA_Window_ContextMenu.Finalize( 2, nil )


end


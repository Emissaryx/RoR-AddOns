<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

<Windows>
 
  <Window name="GetStats_Window_Template" handleinput="true" savesettings="false" id="221" movable="true" popable="true">
    <Size><AbsPoint x="370" y="445" /></Size>
    <Anchors>
      <Anchor point="center" relativePoint="center" relativeTo="Root"><AbsPoint x="0" y="-200" /></Anchor>
    </Anchors>
    <EventHandlers>
      <EventHandler event="OnLButtonUp" function="GMT2.EditBox" />
    </EventHandlers>

    <Windows>
      <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" sticky="false" alpha="0.85">
        <Anchors>
          <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="0" y="0" /></Anchor>
          <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="0" y="0" /></Anchor>
        </Anchors>
      </Window>

      <Label name="$parentName" font="font_clear_small_bold" textalign="center" handleinput="false" autoresize="false" layer="popup">
        <Size><AbsPoint x="240" y="20" /></Size>
        <Color r="255" g="218" b="73" />
        <Anchors>
          <Anchor point="top" relativePoint="top" relativeTo="$parent"><AbsPoint x="0" y="7" /></Anchor>
        </Anchors>
      </Label>

      <Window name="$parentItem1" handleinput="true" id="222" popable="true">
        <Size><AbsPoint x="345" y="20" /></Size>
        <Anchors>
          <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="0" y="30" /></Anchor>
        </Anchors>
        <EventHandlers>
          <EventHandler event="OnLButtonUp" function="GMT2.EditBox" />
        </EventHandlers>

        <Windows>
          <Label name="$parentTitle" font="font_clear_small_bold" autoresize="true" textalign="left" layer="overlay" handleinput="false" wordwrap="true">
            <Size><AbsPoint x="100" y="20" /></Size>
            <Anchors>
              <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="15" y="0" /></Anchor>
            </Anchors>
            <Color r="255" g="255" b="255" />
          </Label>

          <Label name="$parentText" font="font_clear_small_bold" autoresize="true" textalign="left" layer="overlay" handleinput="true" wordwrap="true">
            <Size><AbsPoint x="235" y="24" /></Size>
            <Anchors>
              <Anchor point="topright" relativePoint="topleft" relativeTo="$parentTitle"><AbsPoint x="0" y="0" /></Anchor>
            </Anchors>
            <Color r="255" g="255" b="255" />
            <EventHandlers>
              <EventHandler event="OnHyperLinkRButtonUp" function="EA_ChatWindow.OnHyperLinkRButtonUp" />
              <EventHandler event="OnLButtonUp" function="GMT2.EditBox"/>
            </EventHandlers>
          </Label>

          <EditBox name="$parentEditBox" inherits="EA_EditBox_DefaultFrame" font="font_clear_small_bold" id="51" layer="overlay" maxchars="75" popable="true" handleinput="true" taborder="5">
            <Size><AbsPoint x="235" y="24"/></Size>
            <Anchors>
              <Anchor point="topright" relativePoint="topleft"  relativeTo="$parentTitle"><AbsPoint x="-7" y="-4" /></Anchor>
            </Anchors>
            <EventHandlers>
              <EventHandler event="OnLButtonUp" function="GMT2.EditBox"/>
              <EventHandler event="OnKeyEnter" function="GMT2.EditBox" />
              <EventHandler event="OnKeyEscape" function="GMT2.EditBox" />
            </EventHandlers>
          </EditBox>
        </Windows>
      </Window>

<Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
  <Anchors>
    <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
      <AbsPoint x="-3" y="2"/>
    </Anchor>
  </Anchors>
  <EventHandlers>
    <EventHandler event="OnLButtonUp" function="GMT2.DestroyWindow"/>
  </EventHandlers>
</Button>


      <Button name="$parentNameButton" inherits="EA_Button_ListSort" id="3" textalign="center">
        <Size><AbsPoint x="150" y="30" /></Size>
        <Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground"><AbsPoint x="7" y="53"/></Anchor></Anchors>
      </Button>

      <Button name="$parentIDButton" inherits="EA_Button_ListSort" id="2" textalign="center">
        <Size><AbsPoint x="80" y="30" /></Size>
        <Anchors><Anchor point="topright" relativePoint="topleft" relativeTo="$parentNameButton"><AbsPoint x="0" y="0"/></Anchor></Anchors>
      </Button>

      <Button name="$parentStackButton" inherits="EA_Button_ListSort" id="4" textalign="center">
        <Size><AbsPoint x="125" y="30" /></Size>
        <Anchors><Anchor point="topright" relativePoint="topleft" relativeTo="$parentIDButton"><AbsPoint x="0" y="0"/></Anchor></Anchors>
      </Button>

      <ListBox name="$parentListBox" color="155, 255, 155, 0" autoHideScrollBar="true" rowdef="GetStats_TemplateListboxRow" visiblerows="50" rowcount="1150" rowspacing="0">
        <Size><AbsPoint x="336" y="190" /></Size>
        <Anchors>
          <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground"><AbsPoint x="7" y="83"/></Anchor>
          <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parentBackground"><AbsPoint x="-5" y="-3"/></Anchor>
        </Anchors>
        <ListData table="GetCharTable" populationfunction="">
          <ListColumns>
            <ListColumn windowname="Name"  variable="Buff_Name" format="wstring"/>
            <ListColumn windowname="ID"    variable="ID"        format="wstring"/>
            <ListColumn windowname="Stack" variable="Stack"     format="wstring"/>
          </ListColumns>
        </ListData>
      </ListBox>
    </Windows>
  </Window>

  <Button name="GetStats_TemplateListboxRow" inherits="EA_Button_ResizeIconFrame_NoNormalImage" drawchildrenfirst="true">
    <Size><AbsPoint x="360" y="22" /></Size>
    <EventHandlers>
      <EventHandler event="OnRButtonUp" function="" />
      <EventHandler event="OnMouseOver" function="" />
    </EventHandlers>

    <Windows>
      <FullResizeImage name="$parentBG" inherits="EA_FullResizeImage_BlackTransparent" layer="background" alpha="0.5" handleinput="false">
        <Anchors>
          <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="2" y="1"/></Anchor>
          <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="-7" y="-1"/></Anchor>
        </Anchors>
      </FullResizeImage>

      <Label name="$parentBuff_Name" font="font_clear_small_bold" textalign="left" handleinput="false"
             autoresize="false" ellipsisOnCrop="true" warnOnTextCropped="false" wordwrap="false" layer="popup">
        <Size><AbsPoint x="150" y="20" /></Size>
        <Color r="255" g="218" b="73" />
        <Anchors><Anchor point="left" relativePoint="left" relativeTo="$parent"><AbsPoint x="8" y="2" /></Anchor></Anchors>
      </Label>

      <Label name="$parentID" font="font_clear_small_bold" textalign="top" handleinput="false"
             autoresize="false" ellipsisOnCrop="true" warnOnTextCropped="false" wordwrap="false" layer="popup">
        <Size><AbsPoint x="80" y="20" /></Size>
        <Color r="225" g="125" b="25" />
        <Anchors><Anchor point="right" relativePoint="left" relativeTo="$parentBuff_Name"><AbsPoint x="0" y="0" /></Anchor></Anchors>
      </Label>

      <Label name="$parentStack" font="font_clear_small_bold" textalign="right" handleinput="false"
             autoresize="false" ellipsisOnCrop="true" warnOnTextCropped="false" wordwrap="false" layer="popup">
        <Size><AbsPoint x="125" y="20" /></Size>
        <Color r="225" g="218" b="75" />
        <Anchors><Anchor point="right" relativePoint="left" relativeTo="$parentID"><AbsPoint x="-10" y="0" /></Anchor></Anchors>
      </Label>
    </Windows>
  </Button>

</Windows>
</Interface>

<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

  <!-- Lua -->
  <Scripts>
    <Script file="GMT2.lua"/>
  </Scripts>

  <!-- No custom assets/templates needed when using EA's default close -->

  <Windows>
    <Window name="GMT2Window" inherits="EA_Window_Default" movable="true" savesettings="false">
      <Size><AbsPoint x="300" y="200"/></Size>
      <Anchors>
        <Anchor point="center" relativePoint="center" relativeTo="Root">
          <AbsPoint x="0" y="0"/>
        </Anchor>
      </Anchors>
      <Windows>
        <!-- ensure a proper frame under the close button -->
        <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame"/>
        <Window name="$parentTitleBar"   inherits="EA_TitleBar_Default"/>

        <!-- EA default X button, drawn on top -->
        <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose" layer="overlay">
          <Anchors>
            <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
              <AbsPoint x="-3" y="2"/>
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="GMT2.DestroyWindow"/>
          </EventHandlers>
        </Button>
      </Windows>
    </Window>
  </Windows>

</Interface>

<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Assets>
  </Assets>
<Windows>
			<Window name="GMT2.MapZoneSelect" sticky="false" handleinput="true" layer="overlay" warnOnTextCropped="false" >
             			<Size>						
						<AbsPoint x="200" y="25" />
						</Size>
						<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<AbsPoint x="80" y="45" />
						</Anchor>
						</Anchors>  
					<Windows>
					
						<FullResizeImage name="$parentBG" inherits="EA_FullResizeImage_TintableSolidBackground" layer="background" alpha="0.8" handleinput="false">        
	<Anchors><Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="0" y="0"/></Anchor><Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="0" y="0"/></Anchor></Anchors>
	<TintColor r="0" g="0" b="0" a="0.8"/>						
	</FullResizeImage>							
					
					
                <ComboBox name="$parent_ComboBox" inherits="EA_ComboBox_DefaultResizableMediumLarge" font="font_clear_small_bold" warnOnTextCropped="false">
				             			<Size>						
						<AbsPoint x="250" y="25" />
						</Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
					<EventHandlers>
				<EventHandler event="OnSelChanged" function="GMT2.Map.OnFilterSelChanged" />
				</EventHandlers>
                </ComboBox>
											
				<DynamicImage name="$parentIcon"  texture="map_markers01" slice ="NPC-Travel" layer="background" textureScale="1" handleinput="false" >
                <Size>
                <AbsPoint x="32" y="32" />
                </Size>
				<Anchors>
				<Anchor point="topleft" relativePoint="topright" relativeTo="$parent_ComboBox">
				<AbsPoint x="0" y="-5" />
				</Anchor>
				</Anchors>
                </DynamicImage>          
				  </Windows>
				  
    		</Window>

  		<Window name="GMT2Marker" sticky="false" layer="overlay" >
             			<Size>						
						<AbsPoint x="16" y="16" />
						</Size>
						<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<AbsPoint x="0" y="0" />
						</Anchor>
						</Anchors>     
				  
				  

				  
				  <Windows>
				  		<DynamicImage name="$parentX_0" texture="map_markers01" handleinput="false" popable="false" slice="Waypoint" id="1" textureScale="1.0" layer="overlay">	
						<Size>						
						<AbsPoint x="27" y="27" />
						</Size>
						<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<AbsPoint x="0" y="0" />
						</Anchor>
						</Anchors>						
						</DynamicImage>	
				  
				  		<DynamicImage name="$parentX_1" texture="map_markers01" handleinput="false" popable="false" slice="Waypoint" id="1" textureScale="1.25" layer="default">	
						<Size>						
						<AbsPoint x="31" y="31" />
						</Size>
						<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<AbsPoint x="-1.5" y="-1.5" />
						</Anchor>
						</Anchors>
						<TintColor r="0" g="0" b="0" a="0.8"/>						
						</DynamicImage>	
				
				  
						<Label name="$parentCords" font="font_default_text" handleinput="false" wordwrap="false" autoresize="true" autoresizewidth="true" textalign="left" layer="overlay" >
						<Size>
	                    <AbsPoint x="200" y="32"/>
						</Size>
						<Anchors>
				        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<AbsPoint x="-20" y="-25"/>
				        </Anchor>
						</Anchors>
						</Label>
					
                        
					</Windows>
                  </Window> 
				  
				      <!-- Existing Window definitions -->

<!--  -->
    <Window name="GMT2.MapBossTeleport" sticky="false" handleinput="true" layer="overlay" warnOnTextCropped="false">
      <Size>
        <AbsPoint x="200" y="25"/>
      </Size>
      <Anchors>
        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
          <AbsPoint x="-530" y="-69"/>
        </Anchor>
      </Anchors>
      <Windows>
        <FullResizeImage name="$parentBG" inherits="EA_FullResizeImage_TintableSolidBackground" layer="background" alpha="0.8" handleinput="false">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="0" y="0"/>
            </Anchor>
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
              <AbsPoint x="0" y="0"/>
            </Anchor>
          </Anchors>
          <TintColor r="0" g="0" b="0" a="0.8"/>
        </FullResizeImage>

        <ComboBox name="$parent_BossList" inherits="EA_ComboBox_DefaultResizableMediumLarge" font="font_clear_small_bold" warnOnTextCropped="false">
          <Size>
            <AbsPoint x="250" y="25"/>
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="0" y="0"/>
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnSelChanged" function="GMT2.Map.OnBossSelected"/>
          </EventHandlers>
        </ComboBox>
      </Windows>
    </Window>
		  <!--  -->
</Windows>
</Interface>

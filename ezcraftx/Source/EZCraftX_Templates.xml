<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Windows>

    <Window name="EZCraftX_Templates.PowerPreview" inherits="EA_Window_Default" savesettings="false" movable="false">
      <Size>
        <AbsPoint x="64" y="24"/>
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center"/>
      </Anchors>
      <Windows>
        <FullResizeImage name="$parent.Background" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false" alpha="0.75">
          <TintColor r="0" g="0" b="0"/>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft"/>
            <Anchor point="bottomright" relativePoint="bottomright"/>
          </Anchors>
        </FullResizeImage>
        <Label name="$parent.label" font="font_chat_text_no_outline" textalign="center" inherits="EA_Settings_ItemTitle">
          <Size>
            <AbsPoint x="64" y="24"/>
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="0" y="3"/>
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="0" a="255"/>
        </Label>
      </Windows>
      <EventHandlers>
        <EventHandler event="OnMouseOver" function="EZCraftX.OnMouseOver_PowerPreview"/>
      </EventHandlers>
    </Window>

  </Windows>
</Interface>

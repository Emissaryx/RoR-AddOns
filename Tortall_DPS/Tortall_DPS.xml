<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Scripts>
        <Script file="Tortall_DPS.lua" />
    </Scripts>
    <Windows>
        <Window name="TortallDPSMeter" movable="true" layer="background" popable="false">
            <EventHandlers>
                <EventHandler event="OnInitialize" function="TortallDPSMeter.Initialize" />
                <EventHandler event="OnRButtonUp" function="TortallDPSMeter.OnRButtonUp" />
            </EventHandlers>
            <Anchors>
                <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                    <AbsPoint x="600" y="90" />
                </Anchor>
            </Anchors>
            <Size>
                <AbsPoint x="700" y="220" />
            </Size>
            <Windows>
                <Window name="$parentBG" inherits="EA_Window_DefaultFrame" layer="background">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
                    </Anchors>
                </Window>
                <Label name="$parentTitleLabel" font="font_clear_tiny" handleinput="true" textalign="center" layer="default">
                    <EventHandlers>
                        <EventHandler event="OnRButtonUp" function="TortallDPSMeter.OnRButtonUp" />
                    </EventHandlers>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="">
                            <AbsPoint x="0" y="3" />
                        </Anchor>
                    </Anchors>
                    <Size>
                        <AbsPoint x="600" y="20" />
                    </Size>
                    <Color r="250" g="250" b="250" />
                </Label>
                <Window name="$parentSummary">
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTitleLabel">
                            <AbsPoint x="10" y="40" />
                        </Anchor>
                    </Anchors>
                    <Size>
                        <AbsPoint x="680" y="110" />
                    </Size>
                    <Windows>
                        <FullResizeImage name="$parentBG" inherits="EA_FullResizeImage_TintableSolidBackground"
                                handleinput="false" layer="background" alpha="0.3">
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft"/>
                                <Anchor point="bottomright" relativePoint="bottomright"/>
                            </Anchors>
                            <TintColor r="250" g="0" b="0" />
                        </FullResizeImage>




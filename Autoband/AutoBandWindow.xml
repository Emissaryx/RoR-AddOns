<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
<Scripts>
    <Script file="AutoBandWindow.lua" />
    <Script file="AutoBandWindowLeaderPromotionPopup.lua" />
    <Script file="AutoBandWindowScoreboardPreview.lua" />
</Scripts>

<Assets>
    <Texture name="ab_icon" file="ab_icon.tga" />
    <Texture name="ab_icon_over" file="ab_icon_over.tga" />
</Assets>

<Windows>
    <Window name="AutoBandWindow" inherits="EA_Window_Default" movable="true" layer="secondary" savesettings="false">
        <Size>
            <AbsPoint x="450" y="910" />
        </Size>
        <Anchors>
            <Anchor point="center" relativePoint="center" />
        </Anchors>

        <EventHandlers>
            <EventHandler event="OnInitialize" function="AutoBandWindow.Initialize" />
        </EventHandlers>

        <Windows>
            <!-- Title Bar, Close button, and Corner Image -->
            <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
            <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindow.Hide" />
                </EventHandlers>
            </Button>


            <!-- Tabs and Filter toggle Block -->
            <Window name="$parentTabs">
                <Size>
                    <AbsPoint x="400" y="35" />
                </Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTitleBar"/>
                    <Anchor point="bottomright" relativePoint="topright" relativeTo="$parentTitleBar"/>
                </Anchors>

                <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_MetalFill">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"/>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"/>
                    </Anchors>
                </FullResizeImage>
                <Windows>
                    <Window name="$parentSeparatorLeft" inherits="EA_Window_TabSeparatorLeftSide" layer="background" popable="false">
                        <Anchors>
                        <Anchor point="bottomleft" relativePoint="bottomleft">
                        <AbsPoint x="0" y="-6" />
                        </Anchor>
                        <Anchor point="bottomleft" relativePoint="topright" relativeTo="$parentTemplate">
                        <AbsPoint x="0" y="-6" />
                        </Anchor>
                        </Anchors>
                    </Window>

                    <Button name="$parentTemplate" inherits="EA_Button_Tab" id="1">
                        <Size>
                            <AbsPoint x="124" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                        <AbsPoint x="25" y="0" />
                        </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                        </EventHandlers>
                    </Button>
                    <Button name="$parentTools" inherits="EA_Button_Tab" id="2">
                        <Size>
                            <AbsPoint x="124" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                        <Anchor point="right" relativePoint="left" relativeTo="$parentTemplate">
                        <AbsPoint x="0" y="0" />
                        </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                        </EventHandlers>
                    </Button>
            
                    <Button name="$parentConfig" inherits="EA_Button_Tab" id="3">
                        <Size>
                            <AbsPoint x="124" y="35" />
                        </Size>
                        <TextOffset x="0" y="5" />
                        <Anchors>
                        <Anchor point="right" relativePoint="left" relativeTo="$parentTools">
                        <AbsPoint x="0" y="0" />
                        </Anchor>
                        </Anchors>
                        <EventHandlers>
                            <EventHandler event="OnLButtonUp" function="AutoBandWindow.OnLButtonUpTab" />
                        </EventHandlers>
                    </Button>

                    <Window name="$parentSeparatorRight" inherits="EA_Window_TabSeparatorRightSide" layer="background" popable="false">
                        <Anchors>
                        <Anchor point="bottomright" relativePoint="topleft" relativeTo="$parentConfig">
                        <AbsPoint x="0" y="-6" />
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright" >
                        <AbsPoint x="0" y="-6" />
                        </Anchor>
                        </Anchors>
                    </Window>
                </Windows>
            </Window>
            <!-- TABS End -->

            <!-- Main Window Background -->
            <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" handleinput="true" popable="false">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft" >
                        <AbsPoint x="0" y="32" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" />
                </Anchors>
            </Window>

            <!-- AutoBandTabsWindow -->
            <Window name="AutoBandTabsWindow" movable="false">
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTabs"/>
                    <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"/>
                </Anchors>
            </Window>

            <Window name ="AutoBandWindowTemplateTab" inherits ="AutoBandWindowTemplate"/>
            <Window name ="AutoBandWindowToolsTab" inherits ="AutoBandWindowTools"/>
            <Window name ="AutoBandWindowConfigTab" inherits ="AutoBandWindowConfig"/>
        </Windows>
    </Window>    <!-- AutoBandWindow -->

    <Window name="AutoBandMapIcon" layer="default" movable="false" popable="false" savesettings="true">
        <Size>
            <AbsPoint x="32" y="32"/>
        </Size>
        <Anchors>
            <Anchor point="bottomright"
                    relativeTo="EA_Window_OverheadMapMapDisplay"
                    relativePoint="topleft">
                <AbsPoint x="-75" y="-15" />
            </Anchor>
        </Anchors>
        <Windows>
            <Button name="$parentButton" inherits="DefaultButton" backgroundtexture="ab_icon" highlighttexture="ab_icon_over" layer="default" texturescale="1">
                <Size>
                    <AbsPoint x="32" y="32"/>
                </Size>
                                <EventHandlers>
                                        <EventHandler event="OnLButtonUp" function="AutoBand.cmd_toggle_gui"/>
                                        <EventHandler event="OnRButtonUp" function="AutoBand.HandleIconRightClick"/>
                                        <EventHandler event="OnMouseOver" function="AutoBand.OnIconMouseOver" />
                                        <EventHandler event="OnMouseLeave" function="AutoBand.OnIconMouseLeave" />
                                </EventHandlers>
                <TexSlices>
                    <Normal id="SquareButton" /> 
                    <NormalHighlit id="SquareButton-Rollover" /> 
                    <Pressed id="SquareButton-Depressed" /> 
                    <PressedHighlit id="SquareButton-Depressed" /> 
                </TexSlices>
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parent" relativePoint="topleft"/>
                </Anchors>
            </Button>
        </Windows>
    </Window>

    <Window name="AutoBandCopyLinkWindow" inherits="EA_Window_Default" movable="true" layer="popup" savesettings="false" show="false">
        <Size>
            <AbsPoint x="560" y="200" />
        </Size>
        <Anchors>
            <Anchor point="center" relativePoint="center">
                <AbsPoint x="0" y="-120" />
            </Anchor>
        </Anchors>
        <EventHandlers>
            <EventHandler event="OnInitialize" function="AutoBand.OnCopyLinkInitialize" />
            <EventHandler event="OnKeyEscape" function="AutoBand.HideCopyLink" />
        </EventHandlers>
        <Windows>
            <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
            <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBand.HideCopyLink" />
                </EventHandlers>
            </Button>
            <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft"><AbsPoint x="0" y="32" /></Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" />
                </Anchors>
            </Window>
            <Label name="$parentInstruction" font="font_clear_small" textalign="left" wordwrap="false" mouseovertext="false">
                <Size><AbsPoint x="520" y="24" /></Size>
                <Anchors><Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft"><AbsPoint x="16" y="12" /></Anchor></Anchors>
                <Color r="230" g="230" b="230" />
            </Label>
            <EditBox name="$parentUrlInput" inherits="EA_EditBox_DefaultFrame_Multiline" maxchars="1000" taborder="1" linecount="2">
                <Size><AbsPoint x="520" y="46" /></Size>
                <Anchors><Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft"><AbsPoint x="16" y="44" /></Anchor></Anchors>
                <TextOffset x="6" y="2" />
            </EditBox>
            <Button name="$parentCloseButton" inherits="EA_Button_DefaultResizeable" textalign="center">
                <Size><AbsPoint x="120" y="40" /></Size>
                <Anchors><Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parentBackground"><AbsPoint x="-16" y="-22" /></Anchor></Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBand.HideCopyLink" />
                </EventHandlers>
            </Button>
        </Windows>
    </Window>

    <Window name="AutoBandWindowLeaderPromotionPopup" inherits="EA_Window_Default" movable="true" layer="popup" savesettings="false" show="false">
        <Size>
            <AbsPoint x="620" y="380" />
        </Size>
        <Anchors>
            <Anchor point="center" relativePoint="center">
                <AbsPoint x="0" y="-40" />
            </Anchor>
        </Anchors>
        <EventHandlers>
            <EventHandler event="OnInitialize" function="AutoBandWindowLeaderPromotionPopup.Initialize" />
            <EventHandler event="OnKeyEscape" function="AutoBandWindowLeaderPromotionPopup.Hide" />
        </EventHandlers>
        <Windows>
            <!-- Title Bar, Close button -->
            <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
            <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowLeaderPromotionPopup.Hide" />
                </EventHandlers>
            </Button>

            <!-- Background Frame -->
            <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft">
                        <AbsPoint x="0" y="32" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" />
                </Anchors>
            </Window>

            <Label name="$parentSummaryLabel" font="font_default_text" textalign="left" wordwrap="true" mouseovertext="false">
                <Size><AbsPoint x="572" y="60" /></Size>
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="24" y="18" />
                    </Anchor>
                </Anchors>
                <Color r="230" g="230" b="230" />
            </Label>
            <Window name="$parentSectionSeparator" inherits="EA_Window_DefaultSeparator" handleinput="false">
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="0" y="61" />
                    </Anchor>
                    <Anchor point="topright" relativeTo="$parentBackground" relativePoint="topright">
                        <AbsPoint x="0" y="61" />
                    </Anchor>
                </Anchors>
            </Window>
            <Label name="$parentDetailsLabel" font="font_default_text" textalign="left" wordwrap="true" mouseovertext="false">
                <Size><AbsPoint x="572" y="172" /></Size>
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="24" y="93" />
                    </Anchor>
                </Anchors>
                <Color r="255" g="204" b="102" />
            </Label>
            <Button name="$parentOpenConfigButton" inherits="EA_Button_DefaultResizeable" textalign="center">
                <Size><AbsPoint x="160" y="40" /></Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="bottomleft">
                        <AbsPoint x="24" y="-20" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowLeaderPromotionPopup.OnOpenConfig" />
                </EventHandlers>
            </Button>
            <Button name="$parentCloseButton" inherits="EA_Button_DefaultResizeable" textalign="center">
                <Size><AbsPoint x="120" y="40" /></Size>
                <Anchors>
                    <Anchor point="bottomright" relativePoint="bottomright">
                        <AbsPoint x="-24" y="-20" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowLeaderPromotionPopup.Hide" />
                </EventHandlers>
            </Button>
        </Windows>
    </Window>

    <Window name="AutoBandWindowScoreboardPreview" inherits="EA_Window_Default" movable="true" layer="popup" savesettings="false" show="false">
        <Size>
            <AbsPoint x="540" y="420" />
        </Size>
        <Anchors>
            <Anchor point="center" relativePoint="center">
                <AbsPoint x="0" y="-20" />
            </Anchor>
        </Anchors>
        <EventHandlers>
            <EventHandler event="OnInitialize" function="AutoBandWindowScoreboardPreview.Initialize" />
            <EventHandler event="OnKeyEscape" function="AutoBandWindowScoreboardPreview.Hide" />
        </EventHandlers>
        <Windows>
            <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
            <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowScoreboardPreview.Hide" />
                </EventHandlers>
            </Button>

            <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame">
                <Anchors>
                    <Anchor point="topleft" relativePoint="topleft">
                        <AbsPoint x="0" y="32" />
                    </Anchor>
                    <Anchor point="bottomright" relativePoint="bottomright" />
                </Anchors>
            </Window>

            <Label name="$parentSummaryLabel" font="font_default_text" textalign="left" wordwrap="true" mouseovertext="false">
                <Size><AbsPoint x="492" y="48" /></Size>
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="24" y="14" />
                    </Anchor>
                </Anchors>
                <Color r="230" g="230" b="230" />
            </Label>

            <Window name="$parentSectionSeparator" inherits="EA_Window_DefaultSeparator" handleinput="false">
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="0" y="55" />
                    </Anchor>
                    <Anchor point="topright" relativeTo="$parentBackground" relativePoint="topright">
                        <AbsPoint x="0" y="55" />
                    </Anchor>
                </Anchors>
            </Window>

            <Label name="$parentDetailsLabel" font="font_chat_text" textalign="left" wordwrap="true" mouseovertext="false">
                <Size><AbsPoint x="492" y="240" /></Size>
                <Anchors>
                    <Anchor point="topleft" relativeTo="$parentBackground" relativePoint="topleft">
                        <AbsPoint x="24" y="88" />
                    </Anchor>
                </Anchors>
                <Color r="255" g="204" b="102" />
            </Label>

            <Button name="$parentConfirmButton" inherits="EA_Button_DefaultResizeable" textalign="center">
                <Size><AbsPoint x="120" y="40" /></Size>
                <Anchors>
                    <Anchor point="bottomleft" relativePoint="bottomleft">
                        <AbsPoint x="24" y="-20" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowScoreboardPreview.OnConfirm" />
                </EventHandlers>
            </Button>

            <Button name="$parentCancelButton" inherits="EA_Button_DefaultResizeable" textalign="center">
                <Size><AbsPoint x="120" y="40" /></Size>
                <Anchors>
                    <Anchor point="bottomright" relativePoint="bottomright">
                        <AbsPoint x="-24" y="-20" />
                    </Anchor>
                </Anchors>
                <EventHandlers>
                    <EventHandler event="OnLButtonUp" function="AutoBandWindowScoreboardPreview.OnCancel" />
                </EventHandlers>
            </Button>
        </Windows>
    </Window>
</Windows>

</Interface>

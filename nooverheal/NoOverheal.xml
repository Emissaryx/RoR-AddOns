<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Scripts>

		<Script file="no_localization.en.lua" />
		<Script file="no_localization.de.lua" />
		<Script file="no_SlashHandler.lua" />
		<Script file="NoOverheal.lua" />
    </Scripts>
    <Windows>
        <Window name="NoOverheal_Window" popable="false" movable="true" savesettings="true">
            <Size>
                <AbsPoint x="106" y="30" />
            </Size>
            <Anchors>
                <Anchor point="topleft" relativePoint="topleft" relativeTo="Root">
                    <AbsPoint x="280" y="220" />
                </Anchor>
            </Anchors>
                    <EventHandlers>
						<EventHandler event="OnMouseOver" function="NoOverheal.OnMouseOver" />
						<EventHandler event="OnMouseOverEnd" function="NoOverheal.OnMouseOverEnd" />
                        <EventHandler event="OnLButtonUp" function="NoOverheal.OnLButtonUp" />
                        <EventHandler event="OnMButtonUp" function="NoOverheal.OnMButtonUp" />
                        <EventHandler event="OnRButtonUp" function="NoOverheal.OnRButtonUp" />
                    </EventHandlers>
            <Windows>

                <Label name="NoOverheal_WindowText" font="font_default_text_small" autoresize="true" textalign="center" layer="popup" popable="false" handleinput="false">
                    <Size>
                        <AbsPoint x="110" y="22" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft"  relativeTo="NoOverheal_Window">
                            <AbsPoint x="0" y="7" />
                        </Anchor>
                    </Anchors>
                    <Color r="255" g="255" b="255" a="255" />
                </Label>

                <Label name="NoOverheal_WindowNameText" font="font_default_text_small" autoresize="true" textalign="left" layer="popup" popable="false" handleinput="false">
                    <Size>
                        <AbsPoint x="200" y="22" />
                    </Size>
                    <Anchors>
                        <Anchor point="right" relativePoint="left"  relativeTo="NoOverheal_WindowText">
                            <AbsPoint x="5" y="0" />
                        </Anchor>
                    </Anchors>
                    <Color r="255" g="255" b="255" a="128" />
                </Label>

            </Windows>
        </Window>
    </Windows>
</Interface>


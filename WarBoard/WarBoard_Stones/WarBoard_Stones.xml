<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

	<Windows>
		<Window name="WarBoard_Stones" inherits="EA_Window_Default" movable="false" layer="secondary" savesettings="false">
			<Size>
				<AbsPoint x="75" y="30" />
			</Size>

			<EventHandlers>
				<EventHandler event="OnLButtonUp" function="WarBoard_Stones.OnLClick" />
				<EventHandler event="OnMButtonUp" function="WarBoard_Stones.OnMClick" />
				<EventHandler event="OnRButtonUp" function="WarBoard_Stones.OnRClick" />
				<EventHandler event="OnMouseOver" function="WarBoard_Stones.OnMouseOver" />
			</EventHandlers>

			<Windows>
				<FullResizeImage name="$parentBackground" inherits="ModBackgroundTemplate" />

				<Label name="$parentText" font="font_clear_small_bold" textalign="left" layer="default" handleinput="false">
					<Size>
						<AbsPoint x="65" y="30" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentIcon">
							<AbsPoint x="8" y="7" />
						</Anchor>
					</Anchors>
					<Color r="255" g="255" b="255" />
				</Label>

				<DynamicImage name="$parentIcon" textureScale="0.3" handleinput="false">
					<Size>
						<AbsPoint x="20" y="20" />
					</Size>
					<Anchors>
						<Anchor point="topLeft" relativePoint="topleft">
							<AbsPoint x="5" y="5" />
						</Anchor>
					</Anchors>
				</DynamicImage>
			</Windows>
		</Window>
	</Windows>
</Interface>
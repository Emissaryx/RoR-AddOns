<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

	<Windows>
	
		<Window name="wbLeadHelperSimpleListRowTemplate">
			<Size>
				<AbsPoint x="400" y="20" />
			</Size>
			<Windows>
				<FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
					</Anchors>
				</FullResizeImage>
				<Label name="$parentText" font="font_chat_text" wordwrap="false" handleinput="true" ignoreFormattingTags="true">
					<Size>
						<AbsPoint x="400" y="20" />
					</Size>
					<Anchors>
						<Anchor>
							<AbsPoint x="5" y="3" />
						</Anchor>
					</Anchors>
				</Label>
			</Windows>
		</Window>		
		
	</Windows>
</Interface>
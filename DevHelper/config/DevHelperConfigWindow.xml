<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">

<Windows>
	<Window name="DevHelperConfigWindow" inherits="EA_Window_Default" movable="true" savesettings="false">
		<Size>
			<AbsPoint x="450" y="590" />
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" />
		</Anchors>

		<EventHandlers>
			<EventHandler event="OnInitialize" function="DevHelperConfigWindow.Initialize" />
		</EventHandlers>

		<Windows>
			<!-- Title Bar, Close button, and Corner Image -->
			<Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
			<Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
				<EventHandlers>
					<EventHandler event="OnLButtonUp" function="DevHelperConfigWindow.Hide" />
				</EventHandlers>
			</Button>


			<!-- Tabs and Filter toggle Block -->
			<Window name="$parentTabs">
				<Size>
					<AbsPoint x="400" y="35" />
				</Size>
				<Anchors>
					<Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTitleBar"/>
					<Anchor point="bottomright" relativePoint="topright" relativeTo="$parentTitleBar"/>
				</Anchors>

				<FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_MetalFill">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"/>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"/>
					</Anchors>
				</FullResizeImage>
				<Windows>
					<Window name="$parentSeparatorLeft" inherits="EA_Window_TabSeparatorLeftSide" layer="background" popable="false">
						<Anchors>
						<Anchor point="bottomleft" relativePoint="bottomleft">
						<AbsPoint x="0" y="-6" />
						</Anchor>
						<Anchor point="bottomleft" relativePoint="topright" relativeTo="$parentMessages">
						<AbsPoint x="0" y="-6" />
						</Anchor>
						</Anchors>
					</Window>

					<Button name="$parentMessages" inherits="EA_Button_Tab" id="1">
						<Size>
							<AbsPoint x="124" y="35" />
						</Size>
						<TextOffset x="0" y="5" />
						<Anchors>
						<Anchor point="topleft" relativePoint="topleft">
						<AbsPoint x="25" y="0" />
						</Anchor>
						</Anchors>
						<EventHandlers>
							<EventHandler event="OnLButtonUp" function="DevHelperConfigWindow.OnLButtonUpTab" />
						</EventHandlers>
					</Button>

					<Button name="$parentConfig" inherits="EA_Button_Tab" id="2">
						<Size>
							<AbsPoint x="124" y="35" />
						</Size>
						<TextOffset x="0" y="5" />
						<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentMessages">
						<AbsPoint x="0" y="0" />
						</Anchor>
						</Anchors>
						<EventHandlers>
							<EventHandler event="OnLButtonUp" function="DevHelperConfigWindow.OnLButtonUpTab" />
						</EventHandlers>
					</Button>

					<Window name="$parentSeparatorRight" inherits="EA_Window_TabSeparatorRightSide" layer="background" popable="false">
						<Anchors>
						<Anchor point="bottomright" relativePoint="topleft" relativeTo="$parentConfig">
						<AbsPoint x="0" y="-6" />
						</Anchor>
						<Anchor point="bottomright" relativePoint="bottomright" >
						<AbsPoint x="0" y="-6" />
						</Anchor>
						</Anchors>
					</Window>
				</Windows>
			</Window>
			<!-- TABS End -->

			<!-- Main Window Background -->
			<Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" handleinput="true" popable="false">
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" >
						<AbsPoint x="0" y="32" />
					</Anchor>
					<Anchor point="bottomright" relativePoint="bottomright" />
				</Anchors>
			</Window>

			<!-- DevHelperConfigWindow tabs content area -->
			<Window name="DevHelperConfigWindowTabsContent" movable="false">
				<Anchors>
					<Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTabs"/>
					<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"/>
				</Anchors>
			</Window>

			<Window name ="DevHelperMessagesTabContent" inherits ="DevHelperMessagesTab"/>
			<Window name ="DevHelperConfigTabContent" inherits ="DevHelperConfigTab"/>

		</Windows>
	</Window>	<!-- DevHelperConfigWindow -->

</Windows>

</Interface>
